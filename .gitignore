# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Environments
.venv/
venv/
.env

# Secrets / credentials -- NEVER commit API keys
anthropic.key
*.key
*.pem
secrets/
.env.*
!.env.example

# uv
uv.lock

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Hydra / experiment outputs
outputs/
multirun/

# Run results (keyed by config hash + seed); transient runs are ignored, but the
# curated exemplary-run write-ups (results/exemplary/) are committed.
results/*
!results/.gitkeep
!results/exemplary

# Notebooks: committed demonstration notebooks are tracked; scratch is ignored.
notebooks/*
!notebooks/.gitkeep
!notebooks/*.ipynb

# Jupyter checkpoints (can appear anywhere, incl. under results/exemplary/)
.ipynb_checkpoints/

# OS
.DS_Store

# Coverage artifacts
.coverage
htmlcov/
coverage.xml
